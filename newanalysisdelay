]
# ─────────────────────────────────────────────
# ANALYSIS — matching colleague's exact logic
# ─────────────────────────────────────────────

results = []

for trial in trials:
    trial_id = trial["trial_id"]

    # --- Load metadata (three values recorded at trial start) ---
    with open(trial["metadata_path"], "r") as f:
        metadata = json.load(f)

    # Value 1: QTM capture start time on laptop clock (ms)
    # = time.time()*1000 captured when QTM start event_packet was received
    laptop_time_mocap_start_ms = metadata["pc_time_qtm_start_ms"]

    # Value 2: QTM computer to laptop RTT (ms)
    # Your PC IS the QTM machine, so this is 0. Keep it explicit for clarity.
    laptop_to_qtm_rtt_ms = 0.0

    # Value 3: Neon companion device to laptop time offset (ms)
    # = PC_time - Phone_time, measured by Pupil real-time API
    laptop_to_neon_time_offset_ms = metadata["phone_to_pc_time_offset_ms"]

    # --- Step 1: Get UTC timestamp of first eye camera frame ---
    recording = nr.open(trial["neon_recording_path"])
    first_eye_frame_utc_ms = recording.eye.time[0] / 1e6   # nanoseconds → milliseconds

    # --- Step 2: Calculate impact time on companion device (phone) clock ---
    ms_per_neon_frame = 1000 / trial["neon_fps"]            # 5ms at 200Hz
    neon_marker_impact_phone_ms = first_eye_frame_utc_ms + (trial["frame_of_impact_neon"] * ms_per_neon_frame)

    # --- Step 3: Convert Neon impact time to laptop clock ---
    # laptop_to_neon_time_offset = PC_time - Phone_time
    # so: laptop_time = phone_time + offset
    neon_marker_impact_laptop_ms = neon_marker_impact_phone_ms + laptop_to_neon_time_offset_ms

    # --- Step 4: Calculate impact time on laptop clock from QTM ---
    # laptop_time_mocap_start_ms is already on laptop clock
    # subtract half RTT to correct for the command travel time (negligible here but explicit)
    ms_per_qtm_frame = 1000 / trial["qtm_fps"]              # 8.333ms at 120Hz
    qtm_marker_impact_laptop_ms = (laptop_time_mocap_start_ms - (laptop_to_qtm_rtt_ms / 2)) \
                                  + (trial["frame_of_impact_qtm"] * ms_per_qtm_frame)

    # --- Step 5: Compute offset ---
    # Negative = Neon sees the event LATER than QTM (matches colleague's sign convention)
    offset_ms = qtm_marker_impact_laptop_ms - neon_marker_impact_laptop_ms

    results.append({
        "trial_id":                      trial_id,
        "first_eye_frame_utc_ms":        first_eye_frame_utc_ms,
        "neon_marker_impact_phone_ms":   neon_marker_impact_phone_ms,
        "neon_marker_impact_laptop_ms":  neon_marker_impact_laptop_ms,
        "qtm_marker_impact_laptop_ms":   qtm_marker_impact_laptop_ms,
        "laptop_to_neon_time_offset_ms": laptop_to_neon_time_offset_ms,
        "laptop_to_qtm_rtt_ms":          laptop_to_qtm_rtt_ms,
        "offset_ms":                     offset_ms,
    })

    print(f"[{trial_id}]")
    print(f"  laptop_to_neon_time_offset_ms : {laptop_to_neon_time_offset_ms:.2f} ms")
    print(f"  laptop_to_qtm_rtt_ms          : {laptop_to_qtm_rtt_ms:.2f} ms")
    print(f"  first_eye_frame_utc_ms        : {first_eye_frame_utc_ms:.2f} ms")
    print(f"  neon_marker_impact_phone_ms   : {neon_marker_impact_phone_ms:.2f} ms")
    print(f"  neon_marker_impact_laptop_ms  : {neon_marker_impact_laptop_ms:.2f} ms")
    print(f"  qtm_marker_impact_laptop_ms   : {qtm_marker_impact_laptop_ms:.2f} ms")
    print(f"  offset (QTM - Neon)           : {offset_ms:.2f} ms")
    print()

# ─────────────────────────────────────────────
# SUMMARY STATISTICS
# ─────────────────────────────────────────────

offsets = np.array([r["offset_ms"] for r in results])

print("=" * 40)
print("SUMMARY ACROSS ALL TRIALS")
print("=" * 40)
print(f"  N trials       : {len(offsets)}")
print(f"  Min offset     : {offsets.min():.1f} ms")
print(f"  Max offset     : {offsets.max():.1f} ms")
print(f"  Mean offset    : {offsets.mean():.1f} ms")
print(f"  Median offset  : {np.median(offsets):.1f} ms")
print(f"  Std dev        : {offsets.std():.1f} ms")
print()
print("Interpretation:")
if offsets.mean() < 0:
    print(f"  Neon sees events ~{abs(offsets.mean()):.1f} ms LATER than QTM on average.")
    print(f"  To align: shift Neon timestamps earlier by {abs(offsets.mean()):.1f} ms.")
else:
    print(f"  Neon sees events ~{offsets.mean():.1f} ms EARLIER than QTM on average.")
    print(f"  To align: shift Neon timestamps later by {offsets.mean():.1f} ms.")
