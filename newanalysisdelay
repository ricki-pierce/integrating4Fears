    {"trial_id": "trial_03", "neon_recording_path": r"C:\Users\AoMV Lab\Desktop\Today Marker Testing 8\Native Recording Data\2026-04-08_13-32-19-4be5d2fb", "metadata_path": r"C:\Users\AoMV Lab\Desktop\Today Marker Testing 8\metadata_drop_Trial3_test.json", "frame_of_impact_neon": 909, "frame_of_impact_qtm": 918, "neon_fps": 200, "qtm_fps": 120},
    {"trial_id": "trial_04", "neon_recording_path": r"C:\Users\AoMV Lab\Desktop\Today Marker Testing 8\Native Recording Data\2026-04-08_13-32-51-11536e56", "metadata_path": r"C:\Users\AoMV Lab\Desktop\Today Marker Testing 8\metadata_drop_Trial4_test.json", "frame_of_impact_neon": 460, "frame_of_impact_qtm": 634, "neon_fps": 200, "qtm_fps": 120},
    {"trial_id": "trial_05", "neon_recording_path": r"C:\Users\AoMV Lab\Desktop\Today Marker Testing 8\Native Recording Data\2026-04-08_13-33-21-4b056ff2", "metadata_path": r"C:\Users\AoMV Lab\Desktop\Today Marker Testing 8\metadata_drop_Trial5_test.json", "frame_of_impact_neon": 340, "frame_of_impact_qtm": 565, "neon_fps": 200, "qtm_fps": 120},
